## health-ai-service environment variables (example)
## Copy to `.env` and fill your real secrets locally.

# -------- Optional: local LLM (llama.cpp) --------
# Used only when USE_FOOD_V2=1 for optional dietary-constraint parsing (`restrictions.py`).
# `/recommend` is always engine-only (model.pkl + food catalog).
USE_LOCAL_LLM=0
LLAMA_BASE_URL=http://127.0.0.1:8080
LLAMA_API_KEY=
LLAMA_MODEL=local-gguf
LLAMA_TIMEOUT_S=60
LLAMA_MAX_TOKENS=1400
LLAMA_TEMPERATURE=0.4

# -------- Service --------
LOG_LEVEL=INFO
LOCALE=vi

# Optional: override paths if you mount different locations
# MODEL_PATH=
# FOODS_CSV_PATH=
# FOODS_V2_CSV_PATH=
# USE_FOOD_V2=0
