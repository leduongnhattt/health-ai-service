## Local-only secrets for health-ai-service
## DO NOT COMMIT THIS FILE (it's ignored by repo .gitignore)

# `/recommend` is engine-only (model.pkl + food catalog). Optional llama for USE_FOOD_V2 dietary parsing.
# Note: when running via docker-compose.local-llm.yml, LLAMA_BASE_URL is overridden to http://llama:8080
USE_LOCAL_LLM=0
LLAMA_BASE_URL=http://127.0.0.1:8080
LLAMA_API_KEY=
LLAMA_MODEL=local-gguf
LLAMA_TIMEOUT_S=180
LLAMA_MAX_TOKENS=700
LLAMA_TEMPERATURE=0.4
LLAMA_RETRY_MAX=8
LLAMA_RETRY_BACKOFF_S=2.0

LOCALE=vi
LOG_LEVEL=INFO
